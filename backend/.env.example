# ==============================================================================
# TaskFlow Backend — Environment Configuration
# Copy to .env.development (local) and fill in the blanks. Never commit real secrets.
# ==============================================================================

# APP
APP_PORT=4000
APP_ENV=development
TRUST_PROXY=loopback

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:4000

# DATABASE (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=taskflow
# Set to true for managed Postgres that requires TLS (Neon, Supabase, RDS, ...)
DB_SSL=false

# REDIS (currently used only by the /health probe)
# Set REDIS_ENABLED=false if no Redis is provisioned; REDIS_TLS=true for rediss:// providers
REDIS_ENABLED=true
REDIS_TLS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=taskflow:

# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# COOKIES
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
COOKIE_PATH=/
COOKIE_ACCESS_NAME=access_token
COOKIE_REFRESH_NAME=refresh_token

# SWAGGER & DOCUMENTATION
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# SENTRY (Monitoring & Error Reporting)
SENTRY_DSN=

# SECURITY
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# MAIL (Provider can be 'nodemailer', 'sendgrid', or 'google')
MAIL_PROVIDER=nodemailer

# NODEMAILER (SMTP)
NODEMAILER_SMTP_HOST=smtp.ethereal.email
NODEMAILER_SMTP_PORT=587
NODEMAILER_SMTP_USER=
NODEMAILER_SMTP_PASS=
NODEMAILER_MAIL_FROM=noreply@taskflow.local

# GOOGLE / GMAIL (If MAIL_PROVIDER is 'google', only APP_MAIL and APP_PASSWORD are required)
APP_MAIL=
APP_PASSWORD=

# SENDGRID
SENDGRID_API_KEY=
SENDGRID_MAIL_FROM=noreply@taskflow.local

# SEED CREDENTIALS (for npm run seed:run)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-before-running